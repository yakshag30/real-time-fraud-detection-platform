# --- Storage -------------------------------------------------------------
# SQLite (zero-config default) or PostgreSQL (docker compose default)
FRAUD_DATABASE_URL=sqlite:///data/fraud.db
# FRAUD_DATABASE_URL=postgresql://fraud:fraud@localhost:5432/fraud

# --- Scoring policy ------------------------------------------------------
FRAUD_REVIEW_THRESHOLD=0.35
FRAUD_BLOCK_THRESHOLD=0.75
FRAUD_ALERT_MIN_SCORE=0.50
# Weight of the unsupervised Isolation Forest score in the combined risk score
FRAUD_ANOMALY_WEIGHT=0.25

# --- Bootstrap -----------------------------------------------------------
# Train a model and seed demo transactions on first start
FRAUD_BOOTSTRAP=true
FRAUD_BOOTSTRAP_ROWS=1200

# --- Services ------------------------------------------------------------
FRAUD_API_HOST=127.0.0.1
FRAUD_API_PORT=8000
API_URL=http://127.0.0.1:8000

# --- Paths ---------------------------------------------------------------
FRAUD_DATA_DIR=data
FRAUD_ARTIFACTS_DIR=artifacts
